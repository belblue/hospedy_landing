# Plantilla de variables. El .env real NO se commitea: vive en la VM de deploy
# y se edita desde el CI/CD Manager (Apps -> hospedy_landing_dev|prod -> .env).

# --- Gestionadas por el pipeline (las deja el alta de la app) ---
DEPLOY_PORT=3015
REGISTRY=registry.silatek.net
PROJECT=hospedy
IMAGE_NAME=hospedy_landing_dev

# --- Propias de la aplicación ---
# API del admin panel, que recibe los formularios: contacto y demo asistida
# (/api/public/solicitudes) y cuenta de demo (/api/demo/request). En dev,
# https://rididadminapi.silatek.net. Vacía = los formularios no se pueden enviar e
# invitan a escribir a hola@hospedy.app.
NUXT_PUBLIC_PANEL_API_BASE=
# Sitekey de Cloudflare Turnstile de los formularios. Vacía = sin widget (mismo aviso).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cuenta de demo bajo demanda (/cuenta-demo): true para ofrecerla (necesita también
# el panel); si no, sale como «Muy pronto».
NUXT_PUBLIC_DEMO_ENABLED=false
# Microsoft Clarity. Vacío = sin analítica (recomendado en dev).
NUXT_PUBLIC_CLARITY_ID=
